# Web
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_STORAGE_ORIGIN=http://localhost:9000

# API
API_PORT=4000
CORS_ORIGIN=http://localhost:3000
WEB_URL=http://localhost:3000
NODE_ENV=development
APP_VERSION=development
API_BODY_LIMIT_BYTES=1048576
LOG_LEVEL=info
SWAGGER_ENABLED=true
TRUST_PROXY=false

# Authentication
AUTH_SESSION_TTL_DAYS=30
AUTH_RESET_TTL_MINUTES=30
AUTH_EXPOSE_RESET_TOKEN=false
AUTH_RESET_WEBHOOK_URL=
AUTH_RESET_WEBHOOK_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/auth/google/callback

# Private S3-compatible storage — local defaults target the MinIO service
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=riddy-development
S3_SECRET_KEY=riddy-development-secret
S3_KYC_BUCKET=riddy-kyc
S3_FORCE_PATH_STYLE=true
S3_SIGNED_URL_TTL_SECONDS=300
MINIO_ROOT_USER=riddy-development
MINIO_ROOT_PASSWORD=riddy-development-secret
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Mercado Pago — use credenciais de teste antes de produção
MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_WEBHOOK_URL=
MERCADO_PAGO_API_URL=https://api.mercadopago.com

# PostgreSQL + PostGIS (development only)
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=riddy
POSTGRES_PASSWORD=change-me
POSTGRES_DB=riddy
DATABASE_URL=postgresql://riddy:change-me@localhost:5433/riddy
DATABASE_POOL_SIZE=10

# Redis, cache, distributed throttling and BullMQ
REDIS_PASSWORD=riddy-development-redis-secret
REDIS_PORT=6379
REDIS_URL=redis://:riddy-development-redis-secret@localhost:6379/0
REDIS_KEY_PREFIX=riddy
CACHE_VEHICLES_TTL_SECONDS=30
THROTTLE_LIMIT=120
THROTTLE_TTL_MS=60000
THROTTLE_BLOCK_DURATION_MS=60000
JOBS_WORKER_ENABLED=true
JOBS_SCHEDULER_ENABLED=true
JOBS_AUTH_CLEANUP_INTERVAL_MS=3600000
